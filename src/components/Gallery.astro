---
// Gallery.astro — блок «Фото работ» (сетка 2x2 на десктопе)
// Реальные фотографии в явном JPEG (.jpg) — URL проверены: HTTP 200 + image/jpeg.
const works = [
  { label: 'Демонтаж', alt: 'Демонтаж здания экскаватором', img: 'https://picsum.photos/seed/heavy-excavator/600/400.jpg' },
  { label: 'Подготовка участка', alt: 'Подготовка строительного участка', img: 'https://picsum.photos/seed/construction-site/600/400.jpg' },
  { label: 'Земляные работы', alt: 'Земляные работы с ковшом экскаватора', img: 'https://picsum.photos/seed/dirt-work/600/400.jpg' },
  { label: 'Спецтехника в деле', alt: 'Спецтехника на стройплощадке', img: 'https://picsum.photos/seed/truck-fleet/600/400.jpg' },
];
---

<section class="bg-[#111111] text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <h2 class="sr-only">Фото наших работ</h2>

    <!-- Сетка: 1 колонка на мобильном, 2x2 на десктопе -->
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        works.map((work) => (
          <li>
            <figure class="group relative overflow-hidden rounded-sm">
              <img
                src={work.img}
                alt={work.alt}
                class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                width="600"
                height="400"
              />
              {/* Желтая плашка с черным текстом в левом нижнем углу */}
              <figcaption class="absolute bottom-0 left-0 bg-yellow-400 px-4 py-2 text-xs font-extrabold uppercase tracking-wide text-black sm:px-5 sm:py-2.5 sm:text-sm">
                {work.label}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

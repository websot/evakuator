---
// Features.astro — блок «Преимущества» (3 колонки на десктопе)
const features = [
  { title: 'Опытная команда', icon: 'check' },
  { title: 'Честные цены и прозрачные условия', icon: 'tablet' },
  { title: 'Соблюдаем сроки', icon: 'calendar' },
];
---

<section class="bg-black text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <h2 class="sr-only">Наши преимущества</h2>

    <!-- Сетка: 1 колонка на мобильном, 3 колонки на десктопе -->
    <ul class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
      {
        features.map((feature) => (
          <li class="flex items-center gap-4 sm:gap-5">
            {/* Иконка в желтом круге */}
            <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-yellow-400 sm:h-16 sm:w-16">
              {feature.icon === 'check' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-black sm:h-8 sm:w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              )}
              {feature.icon === 'tablet' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-black sm:h-8 sm:w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                  <line x1="12" y1="18" x2="12" y2="18"></line>
                </svg>
              )}
              {feature.icon === 'calendar' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-black sm:h-8 sm:w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              )}
            </span>

            <p class="font-sans text-base font-extrabold uppercase leading-snug text-white sm:text-lg">
              {feature.title}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
